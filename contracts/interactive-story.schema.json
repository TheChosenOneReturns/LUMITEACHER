{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-teacher.local/contracts/interactive-story.schema.json",
  "title": "Story Teacher interactive story v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "language", "worldId", "opening", "routes", "finalQuestions"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "language": {"enum": ["es", "en"]},
    "worldId": {"enum": ["space", "fantasy", "ocean", "jungle", "inventions", "mystery"]},
    "opening": {"$ref": "#/$defs/opening"},
    "routes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/route"}},
    "finalQuestions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/question"}
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sensoryCue"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "text": {"type": "string", "minLength": 80, "maxLength": 1500},
        "sensoryCue": {"type": "string", "minLength": 1, "maxLength": 220}
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "consequence", "nextSceneId"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 140},
        "consequence": {"type": "string", "minLength": 1, "maxLength": 220},
        "nextSceneId": {"type": "string", "pattern": "^[a-z0-9-]+$"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "options", "correctAnswer", "skill", "explanation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 300},
        "options": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 220}},
        "correctAnswer": {"type": "integer", "minimum": 0, "maximum": 3},
        "skill": {"enum": ["literal", "inference", "cause_effect"]},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "pages", "checkpoint", "choices"],
      "properties": {
        "id": {"const": "opening"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "pages": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/page"}},
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "choices": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/choice"}}
      }
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "pages"],
      "properties": {
        "id": {"type": "string", "pattern": "^ending-[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "pages": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/page"}}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "pages", "checkpoint", "choices", "endings"],
      "properties": {
        "id": {"type": "string", "pattern": "^route-[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "pages": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/page"}},
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "choices": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/choice"}},
        "endings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/ending"}}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "options", "correctAnswer", "skill", "explanation", "sourceSceneIds"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 300},
        "options": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 220}},
        "correctAnswer": {"type": "integer", "minimum": 0, "maximum": 3},
        "skill": {"enum": ["literal", "inference", "vocabulary", "sequence", "cause_effect"]},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 400},
        "sourceSceneIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
      }
    }
  }
}
